{
  "name": "@roamsocket/server",
  "version": "0.2.0",
  "type": "module",
  "description": "RoamSocket desktop companion: headless WebSocket coding server that pairs with the iOS app, clones repos, runs the agent loop, and opens PRs.",
  "license": "MIT",
  "author": "roamsocket",
  "homepage": "https://github.com/roamsocket/roamsocket-mobile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roamsocket/roamsocket-mobile.git",
    "directory": "desktop-server"
  },
  "bugs": {
    "url": "https://github.com/roamsocket/roamsocket-mobile/issues"
  },
  "keywords": [
    "roamsocket",
    "coding-agent",
    "websocket",
    "ios",
    "cli",
    "ai",
    "github",
    "pairing"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "roamsocket": "bin/roamsocket.js",
    "codesocket": "bin/codesocket.js",
    "codesocket-server": "bin/codesocket.js",
    "anyprov-code-server": "bin/codesocket.js"
  },
  "files": [
    "bin",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "smoke": "tsx scripts/smoke.ts",
    "test:client": "tsx scripts/client-unit.ts && tsx scripts/client-shell-check.ts",
    "test:metal": "tsx scripts/metal-check.ts",
    "test:electron-dom": "tsx scripts/electron-dom-check.ts",
    "electron:dev": "electron-forge start",
    "electron:package": "electron-forge package",
    "electron:make": "electron-forge make",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.5.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-vite": "^7.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.10"
  }
}