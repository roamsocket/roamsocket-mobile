# ---------- AI agent state ----------
# Worktrees created by AI coding agents (Claude Code, Codex, etc.) at the
# repo root. Keep them out of git so multi-session runs don't pollute history.
.worktrees/
# Per-session scratch files (smoke test screenshots, adb helper scripts, etc.)
screenshots/
inspect.py
open_pr.py
# Agent scratch / per-session memory files
.aider*
.continue/
.clinerules/
.cody/
.windsurfrules/
# Codex / Cursor / Claude local caches
.codex/
.cursorignore
.cursorindexerignore
# Per-repo agent rules (use AGENTS.md / CLAUDE.md at root instead)
AGENTS.local.md
CLAUDE.local.md

# ---------- Node / npm ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
.cache/
coverage/
.nyc_output/

# Project build outputs (desktop server)
desktop-server/dist/
desktop-server/build/
desktop-server/out/
desktop-server/coverage/
desktop-server/.vite/
desktop-server/node_modules/.vite/
# Electron Forge packaging output
desktop-server/out/make/

