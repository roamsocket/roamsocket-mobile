/**
 * Cloudflare Workers — static assets only (no Worker script).
 * Deploy: cd landing && npm run deploy
 * Docs: https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roamsocket",
  "compatibility_date": "2026-08-06",
  "preview_urls": true,
  "assets": {
    // Published site files live in public/ (keeps node_modules out of the bundle).
    "directory": "./public",
    // Marketing site with hash anchors only — unknown paths return 404.
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
